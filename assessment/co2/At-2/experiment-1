<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Responsive Layout Design</title>

    <style>
        /* Reset */
        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
        }

        /* Body */
        body{
            font-family:Arial, sans-serif;
            background:#f5f5f5;
        }

        /* Header */
        header{
            background:#0066cc;
            color:white;
            text-align:center;
            padding:20px;
        }

        /* Navigation */
        nav{
            display:flex;
            justify-content:center;
            background:#333;
        }

        nav a{
            color:white;
            text-decoration:none;
            padding:15px 20px;
        }

        nav a:hover{
            background:#555;
        }

        /* Main Layout */
        .container{
            display:flex;
            gap:20px;
            padding:20px;
        }

        /* Sidebar */
        aside{
            flex:1;
            background:#e6e6e6;
            padding:20px;
            border-radius:8px;
        }

        aside ul{
            list-style:none;
        }

        aside li{
            padding:8px 0;
        }

        /* Main Content */
        main{
            flex:3;
            background:white;
            padding:20px;
            border-radius:8px;
        }

        /* Cards */
        .cards{
            display:flex;
            gap:20px;
            margin-top:20px;
        }

        .card{
            flex:1;
            background:#4CAF50;
            color:white;
            padding:40px;
            text-align:center;
            border-radius:8px;
        }

        /* Footer */
        footer{
            background:#222;
            color:white;
            text-align:center;
            padding:15px;
            margin-top:20px;
        }

        /* Tablet View */
        @media (max-width:768px){

            .container{
                flex-direction:column;
            }

            .cards{
                flex-direction:column;
            }

            nav{
                flex-wrap:wrap;
            }
        }

        /* Mobile View */
        @media (max-width:480px){

            nav{
                flex-direction:column;
                align-items:center;
            }

            nav a{
                width:100%;
                text-align:center;
                border-top:1px solid #555;
            }

            header h1{
                font-size:24px;
            }

            .card{
                padding:25px;
            }
        }
    </style>

</head>
<body>

    <header>
        <h1>Retail Website</h1>
    </header>

    <nav>
        <a href="#">Home</a>
        <a href="#">Products</a>
        <a href="#">Offers</a>
        <a href="#">Contact</a>
    </nav>

    <div class="container">

        <aside>
            <h2>Categories</h2>
            <ul>
                <li>Electronics</li>
                <li>Clothing</li>
                <li>Furniture</li>
                <li>Accessories</li>
            </ul>
        </aside>

        <main>
            <h2>Welcome to Our Store</h2>

            <p>
                This webpage demonstrates a responsive layout using CSS Flexbox.
                Resize the browser window to see the layout adapt for desktop,
                tablet, and mobile devices.
            </p>

            <div class="cards">
                <div class="card">Product 1</div>
                <div class="card">Product 2</div>
                <div class="card">Product 3</div>
            </div>
        </main>

    </div>

    <footer>
        <p>&copy; 2026 Retail Website | Responsive Web Design</p>
    </footer>

</body>
</html>
